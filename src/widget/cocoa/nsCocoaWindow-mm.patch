 // Returns a retained view. The caller owns it.
+// Light frosted glass. VibrantLight keeps the material milky even in dark mode.
+static NSView* CreateFrostedGlassView(NSRect aFrame, CGFloat aCornerRadius) {
+  if (@available(macOS 26.0, *)) {
+    auto* glass = [[NSGlassEffectView alloc] initWithFrame:aFrame];
+    glass.cornerRadius = aCornerRadius;
+    // Clear glass is only a faint tint. Regular glass is the milky blur,
+    // and Aqua keeps it light while the browser is in dark mode.
+    glass.style = NSGlassEffectViewStyleRegular;
+    glass.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+    glass.tintColor = [NSColor whiteColor];
+    return glass;
+  }
+  auto* view = CreateVibrancyView(
+      aFrame, NSVisualEffectMaterialUnderWindowBackground, aCornerRadius);
+  view.appearance = [NSAppearance appearanceNamed:NSAppearanceNameVibrantLight];
+  return view;
+}
